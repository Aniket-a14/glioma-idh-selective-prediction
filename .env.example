# ---------------------------------------------------------------------------
# Copy to .env and edit for THIS machine. .env is gitignored; never commit it.
# One canonical path abstraction: nothing in src/ may hard-code an absolute
# path. See docs/research/REPRODUCIBILITY_PROTOCOL.md section "Storage".
# ---------------------------------------------------------------------------

# Root of the external SSD (or, on the GPU server, the large local volume).
# macOS example:  /Volumes/GliomaSSD
# Linux  example: /mnt/glioma
GLIOMA_STORAGE_ROOT=

# Optional overrides. If unset they default to $GLIOMA_STORAGE_ROOT/data and
# $GLIOMA_STORAGE_ROOT/artifacts respectively.
GLIOMA_DATA_ROOT=
GLIOMA_ARTIFACT_ROOT=

# Machine identity, recorded in every run record so results can be attributed.
# One of: local-mac | gpu-server | ci
GLIOMA_MACHINE=local-mac

# MLflow tracking store. Local file-backed store on the SSD by default.
# Leave blank to disable tracking (unit tests, CI).
MLFLOW_TRACKING_URI=

# ---------------------------------------------------------------------------
# EXTERNAL-EVALUATION FIREWALL (docs/research/EXTERNAL_VALIDATION_PROTOCOL.md)
# Must remain 0 until Gate E is signed by the Research Lead. When 0, any code
# path that would compute a metric against UCSF-PDGM or EGD labels raises.
# ---------------------------------------------------------------------------
GLIOMA_EXTERNAL_EVAL_AUTHORIZED=0
