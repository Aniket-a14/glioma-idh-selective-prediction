htmlcov/
coverage.xml

# Packaging build artifacts
*.egg-info/
build/
dist/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Notebooks: strip output before committing (see .pre-commit-config.yaml)
.ipynb_checkpoints/

# Local Claude Code plugin enablement (per-machine, not shared).
