/data
/artifacts
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.nrrd

# Model checkpoints / caches / experiment output
*.ckpt
*.pth
*.pt
*.safetensors
mlruns/
mlflow.db
.cache/

# Restricted clinical metadata (DUA-governed; never committed)
*private*
*phi*
*PHI*

# Environment
.env
.env.local
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
